# Server-only configuration. Do not copy real data, tokens or password files
# into the repository or GitHub Pages output.
SENTENTIA_DB_PATH=/var/lib/sententia/progress.sqlite3
SENTENTIA_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://YOUR-ACCOUNT.github.io
SENTENTIA_REGISTRATION_MODE=disabled
SENTENTIA_SESSION_DAYS=30
