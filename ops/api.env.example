# This file lives on the API server at /etc/sententia/api.env.
# Never put database credentials or account passwords in NEXT_PUBLIC_* values.
SENTENTIA_DB_PATH=/var/lib/sententia/progress.sqlite3
SENTENTIA_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://YOUR_GITHUB_LOGIN.github.io
SENTENTIA_REGISTRATION_MODE=open
