{
  "name": "sententia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "corpus:build": "tsx scripts/corpus/build.mts",
    "corpus:verify": "tsx scripts/corpus/verify.mts",
    "lexicon:dictionary": "node scripts/lexicon/build-dictionary.mjs",
    "lexicon:sentences": "node scripts/sentences/build.mjs",
    "lexicon:build": "tsx scripts/lexicon/assemble.mts",
    "lexicon:verify": "node scripts/lexicon/verify-sources.mjs"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.0.0",
    "dexie": "^4.0.0",
    "ts-fsrs": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.51.0",
    "tsx": "^4.0.0"
  }
